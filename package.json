{
  "name": "aubesee-admin",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun run test:integration && bun run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest --no-watch",
    "prepare": "husky",
    "generate:api": "openapi-typescript ../auberun/api-specs/admin/adminapi.yaml -o ./src/lib/openapi/adminapi.schema.ts && eslint --fix ./src/lib/openapi/*.schema.ts",
    "tag:create:staging": "./scripts/release-tag.sh staging",
    "tag:create:sandbox": "./scripts/release-tag.sh sandbox",
    "tag:create:production": "./scripts/release-tag.sh production"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@playwright/test": "^1.46.0",
    "@sveltejs/adapter-auto": "^3.2.3",
    "@sveltejs/adapter-cloudflare": "^4.7.1",
    "@sveltejs/kit": "^2.5.21",
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@tailwindcss/typography": "^0.5.14",
    "@types/cors": "^2.8.17",
    "@types/eslint": "8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.10",
    "dotenv": "^16.4.5",
    "esbuild": "^0.20.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-svelte": "^2.43.0",
    "husky": "^9.1.4",
    "openapi-typescript": "^7.3.0",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte": "^5.0.0-next.216",
    "svelte-check": "^3.8.5",
    "sveltekit-superforms": "^2.16.1",
    "tailwindcss": "^3.4.9",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^7.18.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "zod": "^3.23.8"
  },
  "type": "module",
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "countries-list": "^3.1.1",
    "decimal.js": "^10.4.3",
    "formsnap": "^1.0.1",
    "lucide-svelte": "^0.428.0",
    "openapi-fetch": "^0.10.6",
    "svelte-select": "^5.8.3",
    "theme-change": "^2.5.0",
    "uuid": "^10.0.0",
    "uuidv7": "^1.0.1"
  },
  "trustedDependencies": [
    "@sveltejs/kit",
    "esbuild",
    "svelte-preprocess",
    "workerd"
  ]
}
